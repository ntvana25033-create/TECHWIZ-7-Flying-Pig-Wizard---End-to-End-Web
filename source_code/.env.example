SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=mysql
DB_NAME=campus_coin
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ===== GMAIL SMTP - GUI EMAIL THAT =====
# Bat 2-Step Verification tren tai khoan Google, sau do tao App Password 16 ky tu.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Campus Coin <your_email@gmail.com>

# Local: link reset mo tren chinh may dang chay Django.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Khi deploy, doi thanh domain that, vi du:
# PUBLIC_BASE_URL=https://campuscoin.example.com

# Optional for production realtime notifications
REDIS_URL=
